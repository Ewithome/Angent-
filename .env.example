# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0

# Agent 配置
AGENT_MEMORY_DB=agent_memory.db
AGENT_NOTES_DIR=notes
KNOWLEDGE_DIR=knowledge
CAD_OUTPUT_DIR=outputs/cad

# Agent Harness 配置
HARNESS_MODEL=deepseek-chat
HARNESS_MAX_TOKENS=16384
HARNESS_TIMEOUT_SECONDS=300
HARNESS_HOME=.harness_home
HARNESS_WORKSPACE=.harness_workspace
MCP_CONFIG_FILE=.mcp_servers.json
# true 时链接 ~/.agents/skills、项目 .dsh/skills、Harness home skills 等已有技能
HARNESS_SKILL_INCLUDE_GLOBAL=true
# 额外技能目录，多个用 ; 分隔，例如 C:\Users\xxx\.codex\skills
HARNESS_SKILL_EXTRA_DIRS=

# API 配置
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
